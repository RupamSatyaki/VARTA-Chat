{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.varta.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "VARTA needs access to your camera for video calls and taking photos.",
        "NSMicrophoneUsageDescription": "VARTA needs access to your microphone for audio calls.",
        "NSPhotoLibraryUsageDescription": "VARTA needs access to your photos to let you share them with friends."
      }
    },
    "android": {
      "package": "com.varta.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your contacts."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "00e34edd-03f8-4055-bdf3-22ceabf1bd04"
      }
    }
  }
}
